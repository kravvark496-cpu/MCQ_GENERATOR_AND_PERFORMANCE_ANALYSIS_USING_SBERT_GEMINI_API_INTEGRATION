# Function to handle text extraction from uploaded file
def extract_text_from_file(file_path):
    ext = file_path.rsplit('.', 1)[1].lower()  # Get file extension
    if ext == 'pdf':
        with pdfplumber.open(file_path) as pdf:
            text = ''.join([page.extract_text() for page in pdf.pages])
        return text
    elif ext == 'docx':
        doc = docx.Document(file_path)
        text = ' '.join([para.text for para in doc.paragraphs])
        return text
    elif ext == 'txt':
        with open(file_path, 'r') as file:
            return file.read()
    elif ext == 'csv':
        # Read the CSV file and return the data as a string
        df = pd.read_csv(file_path)
        return df.to_string()  # Convert CSV data to string for MCQ generation
    return None

# Function to generate MCQs based on the provided text or dataset
def generate_mcqs_from_text(text, num_questions=5, mcq_type="Paragraph-Based"):
    if mcq_type == "Paragraph-Based":
        prompt = f"""
        You are an AI assistant helping the user generate multiple-choice questions (MCQs) based on the following text:
        '{text}'
        Please generate {num_questions} MCQs from the text. Each question should have:
        - A clear question
        - Four answer options (labeled A, B, C, D)
        - The correct answer clearly indicated
        Format:
        ## MCQ
        Question: [question]
        A) [option A]
        B) [option B]
        C) [option C]
        D) [option D]
        Correct Answer: [correct option]
        """
    elif mcq_type == "Aptitude-Based":
        prompt = f"""
        You are an AI assistant helping the user generate multiple-choice questions (MCQs) based on the following dataset of aptitude problems:
        '{text}'
        Please generate {num_questions} MCQs from the data. Each question should involve numerical or logical reasoning and:
        - A clear question
        - Four answer options (labeled A, B, C, D)
        - The correct answer clearly indicated
        Format:
        ## MCQ
        Question: [question]
        A) [option A]
        B) [option B]
        C) [option C]
        D) [option D]
        Correct Answer: [correct option]
        """
    response = model.generate_content(prompt).text.strip()
    return response.split("\n\n")  # Split by each question block

